# ==============================================================================
# IP Configuration (Migrated VMs)
# ==============================================================================
# VM1 (api-vm): Internal IP for internal communication
VM1_IP=

# VM2 (db-vm): Internal IP for internal communication
VM2_IP=

# VM3 (workload-vm): Internal IP for scraping / test runner
VM3_IP=

# Public/External IP of VM3 to access Grafana/Prometheus from your browser
WORKLOAD_IP=

# ==============================================================================
# SSH Configuration for Progressive Load Testing
# ==============================================================================
# SSH Usernames for both target VMs
VM1_USER=
VM2_USER=

# Absolute path of project directories on target VMs
VM1_PROJECT_DIR=
VM2_PROJECT_DIR=

# SSH key path (leave blank to use default SSH identity e.g., ~/.ssh/id_rsa)
SSH_KEY=